# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponha ao cliente. Usada só em API routes/Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# Storage
DANFSE_STORAGE_BUCKET=danfse-files
DANFSE_SIGNED_URL_TTL_SECONDS=300
DANFSE_MAX_XML_SIZE_BYTES=2097152

# Render de PDF (produção: Chromium empacotado para serverless)
PUPPETEER_EXECUTABLE_PATH=
CHROMIUM_REMOTE_PACK_URL=

# Gateway de pagamento (checkout hospedado — nunca dado de cartão passa pelo sistema)
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# KMS/Vault para certificado A1 (referência, nunca a chave em si na app)
CERTIFICADO_KMS_KEY_ID=

# Motor NF-e / SEFAZ (por UF, credenciais de homologação/produção)
SEFAZ_AMBIENTE=homologacao
SEFAZ_DISTRIBUICAO_DFE_URL_HOMOLOGACAO=
SEFAZ_DISTRIBUICAO_DFE_URL_PRODUCAO=

# Segredo compartilhado para autenticar o cron/scheduler dos jobs (motor
# NF-e e monitor de CNPJ) — nunca expor as rotas de job sem esse header.
CRON_SECRET=

# E-mail transacional (alertas)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notificacoes@exemplo.com.br

# Consulta cadastral (monitor CNPJ) — provedor externo
CNPJ_PROVIDER_BASE_URL=
CNPJ_PROVIDER_API_KEY=

# URL base da consulta nacional de NFS-e para o QR Code do DANFSe.
# Preencher com a URL oficial vigente do ambiente (produção/homologação).
NFSE_CONSULTA_QRCODE_BASE_URL=

# Logo oficial da NFS-e no cabeçalho do DANFSe. Por padrão é usado um SVG
# que replica a logo. Para cravar o PNG oficial pixel-a-pixel, baixe
# "Logo - NFS-e - Horizontal.png" do portal gov.br/nfse e cole aqui o
# data URI base64 (ex: data:image/png;base64,iVBORw0KGgo...).
DANFSE_LOGO_DATA_URI=
